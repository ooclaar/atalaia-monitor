{
  "name": "atalaia-monitor",
  "version": "1.1.0",
  "description": "Atalaia - Monitoramento Profissional de Ping e Portas.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Ramon Alonso",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ping": "^0.4.4"
  },
  "build": {
    "appId": "com.ramonalonso.atalaia",
    "productName": "Atalaia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  }
}
