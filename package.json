{
  "name": "atalaia-monitor",
  "version": "1.1.0",
  "description": "Atalaia - Monitoramento Profissional de Ping e Portas.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Chief",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "lowdb": "^5.1.0",
    "ping": "^1.0.0"
  },
  "build": {
    "appId": "com.gaudium.atalaia",
    "productName": "Atalaia",
    "win": {
      "target": "portable",
      "icon": null
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/*"
    ]
  }
}
